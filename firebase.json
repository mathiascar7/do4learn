{
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "do4learn",
          "appId": "1:1020698825445:android:5f7d25505a052b62d0ba0c",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "do4learn",
          "configurations": {
            "android": "1:1020698825445:android:5f7d25505a052b62d0ba0c",
            "ios": "1:1020698825445:ios:c5cdafb34ff66d2bd0ba0c",
            "macos": "1:1020698825445:ios:c5cdafb34ff66d2bd0ba0c",
            "web": "1:1020698825445:web:fc3bba97eb32c813d0ba0c",
            "windows": "1:1020698825445:web:d9caaaccf6c6170cd0ba0c"
          }
        }
      }
    }
  },
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/xml" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
